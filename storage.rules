rules_version = '2';

// Cloud Storage rules (TECHNICAL_SPECS §10 "Storage rules").
//   recipes/{recipeId}/**         recipe images: public read (share links), allowlisted write for an existing recipe,
//                                 WebP (JPEG where the browser can't encode WebP) ≤ 2 MB
//   recipe-drop/{uid}/{file}      drop folder: the owner uploads .cook files (≤ 1 MB) and the images they
//                                 reference (≤ 10 MB); only functions read and delete
//   recipe-photos/{uid}/{file}    Add with Gemini (M16, R4.37): a person uploads photos of a recipe (images, ≤ 10 MB
//                                 each, up to 6 per request); only the addRecipeWithGemini function reads them, then deletes them
//   imports/{hid}/{file}          household data import (M4, §13): members of that household upload one zip
//                                 (≤ 20 MB); nobody reads it but the importHousehold function, which deletes it
// Everything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    // Same gate as Firestore (R2.12): a verified address on the allowlist. Cross-service read of Firestore.
    function allowed() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/allowlist/$(request.auth.token.email.lower()));
    }

    // M22: only for a recipe that exists (a new recipe's photo is uploaded right after the recipe is created), so
    // uploads can't pile up under made-up IDs; the weekly maintenance sweeps folders whose recipe is gone.
    match /recipes/{recipeId}/{path=**} {
      allow read: if true;
      allow create, update: if allowed()
        && firestore.exists(/databases/(default)/documents/recipes/$(recipeId))
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)');
      allow delete: if allowed();
    }

    match /recipe-drop/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && allowed()
        && ((file.matches('.*\\.[cC][oO][oO][kK]$') && request.resource.size <= 1024 * 1024)
            || (request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif|avif)')
                && request.resource.size <= 10 * 1024 * 1024));
    }

    match /recipe-photos/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid && allowed()
        && file.matches('[A-Za-z0-9_-]{1,64}[.](jpe?g|png|webp|heic|heif|avif|gif)')
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif|avif)')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    match /imports/{hid}/{file} {
      allow create: if allowed()
        && firestore.exists(/databases/(default)/documents/households/$(hid)/members/$(request.auth.uid))
        && file.matches('[A-Za-z0-9_-]{1,64}[.]zip')
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('application/(zip|x-zip-compressed|octet-stream)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
