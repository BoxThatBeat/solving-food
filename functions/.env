# Non-secret functions config (loaded at deploy and at runtime). PC Express stays off until the owner has set the
# PCX_EMAIL / PCX_PASSWORD secrets; then set PCX_ENABLED=true and PCX_API_KEY (the public x-apikey the PC Express
# website sends; read it from the browser dev tools) and redeploy. See SETUP.md "PC Express".
PCX_ENABLED=false
PCX_API_KEY=
PCX_SIGNIN_URL=
