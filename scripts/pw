#!/usr/bin/env bash
# Playwright CLI wrapper for this repo (see .claude/skills/playwright-cli/SKILL.md).
#
# Runs Microsoft's @playwright/cli pinned to the version whose Playwright matches the nixpkgs browsers in the
# dev shell, and points it at the nixpkgs Chromium so nothing is ever downloaded. Must run inside the dev shell
# (direnv, or `nix develop -c scripts/pw ...`).
#
# Usage: scripts/pw [-s=<session>] <playwright-cli command> [args]
#   scripts/pw open http://localhost:5173/plan
#   scripts/pw resize 430 932
#   scripts/pw screenshot --filename=/tmp/plan.png
#   scripts/pw snapshot
#   scripts/pw close
set -euo pipefail

PW_CLI_VERSION="0.1.19"   # Playwright 1.63.x; keep in step with pkgs.playwright-driver in flake.nix (nix eval shows 1.63.0)

if [[ -z "${PLAYWRIGHT_BROWSERS_PATH:-}" ]]; then
  echo "scripts/pw: PLAYWRIGHT_BROWSERS_PATH is not set. Run inside the dev shell (direnv or nix develop)." >&2
  exit 1
fi

chromium=$(ls -d "$PLAYWRIGHT_BROWSERS_PATH"/chromium-*/chrome-linux*/chrome 2>/dev/null | head -1 || true)
if [[ -z "$chromium" ]]; then
  echo "scripts/pw: no Chromium under $PLAYWRIGHT_BROWSERS_PATH" >&2
  exit 1
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
state="$root/.playwright-cli"           # session logs + generated config; git-ignored
mkdir -p "$state"
config="$state/cli.config.json"
cat > "$config" <<EOF
{
  "browser": {
    "browserName": "chromium",
    "launchOptions": { "executablePath": "$chromium", "headless": true },
    "contextOptions": { "viewport": { "width": 430, "height": 932 }, "deviceScaleFactor": 1 }
  }
}
EOF

# The config only matters for `open`; passing it everywhere is harmless.
args=()
for a in "$@"; do
  args+=("$a")
  if [[ "$a" == "open" ]]; then args+=("--config=$config"); fi
done

cd "$root"
exec npx -y "@playwright/cli@$PW_CLI_VERSION" "${args[@]}"
