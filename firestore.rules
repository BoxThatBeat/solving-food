rules_version = '2';

// Solving Food security rules (TECHNICAL_SPECS §10).
// M0: allowlist, users, directory, households (+ members).
// M1: ingredients, recipes (+ versions), recipeIndex, households/*/favourites, notes, stats (read), and
//     users/*/notifications. Everything else is denied until the milestone that introduces it adds its rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    // Firebase lower-cases emails already; lower() keeps the allowlist key canonical regardless.
    function email() {
      return request.auth.token.email.lower();
    }
    // Email-link sign-in always yields a verified address. Requiring it stops someone from using the
    // Email/Password provider to register an allowlisted address they don't own.
    function verified() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    // R2.12 / NFR4: every grant to a signed-in user requires an allowlist entry for their address.
    function allowed() {
      return verified() && exists(/databases/$(database)/documents/allowlist/$(email()));
    }
    function isMember(hid) {
      return allowed() && exists(/databases/$(database)/documents/households/$(hid)/members/$(me()));
    }

    // ---------- validation helpers

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function validTheme(t) {
      return t is map
        && t.keys().hasOnly(['flavour', 'accent']) && t.keys().hasAll(['flavour', 'accent'])
        && t.flavour in ['latte', 'frappe', 'macchiato', 'mocha']
        && t.accent in ['green', 'teal', 'sapphire', 'blue', 'lavender', 'mauve', 'pink', 'flamingo',
                        'maroon', 'red', 'peach', 'yellow'];
    }
    function validDisplayName(n) {
      return str(n, 1, 40) && n.trim().size() > 0;
    }
    function optStr(d, k, max) {
      return !(k in d) || str(d[k], 0, max);
    }
    function optNum(d, k) {
      return !(k in d) || (d[k] is number && d[k] >= 0);
    }
    function validHousehold(d) {
      return d.keys().hasOnly(['name', 'createdBy', 'periodDays', 'budgetCents', 'currency', 'timezone',
                               'defaultServings', 'plannedMealTypes', 'pcxStoreId', 'currentPeriodId',
                               'settings', 'createdAt'])
        && d.keys().hasAll(['name', 'createdBy', 'periodDays', 'budgetCents', 'currency', 'timezone',
                            'defaultServings', 'plannedMealTypes', 'pcxStoreId'])
        && str(d.name, 1, 60) && d.name.trim().size() > 0
        && d.periodDays is int && d.periodDays >= 1 && d.periodDays <= 28
        && d.budgetCents is int && d.budgetCents >= 0
        && d.currency == 'CAD'
        && str(d.timezone, 1, 64)
        && d.defaultServings is int && d.defaultServings >= 1 && d.defaultServings <= 20
        && d.plannedMealTypes is list && d.plannedMealTypes.size() >= 1
        && d.plannedMealTypes.hasOnly(['breakfast', 'lunch', 'dinner'])
        && str(d.pcxStoreId, 1, 100)
        && (!('settings' in d) || d.settings is map);
    }

    // ---------- allowlist/{emailLower}: sign-up allowlist (R2.12)

    match /allowlist/{emailLower} {
      // Only your own entry: the app checks it after sign-in. No listing.
      allow get: if verified() && emailLower == email();
      // Any allowlisted user can add an address (invite by email, R2.4).
      allow create: if allowed()
        && emailLower == emailLower.lower()
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt', 'inviteHouseholdId'])
        && request.resource.data.addedBy == me()
        && request.resource.data.addedAt == request.time
        && (!('inviteHouseholdId' in request.resource.data) || isMember(request.resource.data.inviteHouseholdId));
    }

    // ---------- users/{uid}: private to the user

    match /users/{uid} {
      allow read: if uid == me() && allowed();
      // First run (with directory/{uid}, same batch). The counter starts at 0.
      allow create: if uid == me() && allowed()
        && request.resource.data.keys().hasOnly(['email', 'activeHouseholdId', 'householdsCreated', 'theme', 'createdAt'])
        && request.resource.data.email == email()
        && request.resource.data.activeHouseholdId == null
        && request.resource.data.householdsCreated == 0
        && validTheme(request.resource.data.theme)
        && request.resource.data.createdAt == request.time;
      // Theme and active household are free to change. householdsCreated only ever goes up by one, to at
      // most 3, and only in the batch that creates a household (R2.3). Decrements are function-only (§10).
      allow update: if uid == me() && allowed()
        && changed().hasOnly(['activeHouseholdId', 'theme', 'householdsCreated'])
        && validTheme(request.resource.data.theme)
        && (request.resource.data.activeHouseholdId == null || str(request.resource.data.activeHouseholdId, 1, 200))
        && (!('householdsCreated' in changed()) || (
              request.resource.data.householdsCreated == resource.data.householdsCreated + 1
              && request.resource.data.householdsCreated <= 3
              && request.resource.data.activeHouseholdId is string
              && !exists(/databases/$(database)/documents/households/$(request.resource.data.activeHouseholdId))
              && existsAfter(/databases/$(database)/documents/households/$(request.resource.data.activeHouseholdId))));
    }

    // ---------- directory/{uid}: readable by every allowlisted user, for invites by name

    match /directory/{uid} {
      allow read: if allowed();
      allow create, update: if uid == me() && allowed()
        && request.resource.data.keys().hasOnly(['displayName', 'displayNameLower'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.displayNameLower == request.resource.data.displayName.lower();
    }


    // ---------- ingredients/{id} (§4.1, §5): public get for share-link pages; allowlisted users list and edit

    function validIngredient(d) {
      return d.keys().hasOnly(['name', 'aliases', 'category', 'defaultLocation', 'allowedMeasures', 'canonicalUnit',
                               'densityGPerMl', 'unitWeightG', 'proteinPer100g', 'shelfLifeDays', 'defaultPackAmount',
                               'defaultPackMeasure', 'defaultCadenceDays', 'freezable', 'isStaple', 'freeUse',
                               'needsReview', 'createdBy', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'aliases', 'category', 'defaultLocation', 'allowedMeasures', 'canonicalUnit',
                            'shelfLifeDays', 'freezable', 'isStaple', 'freeUse', 'needsReview'])
        && str(d.name, 1, 80)
        && d.aliases is list && d.aliases.size() <= 40
        && str(d.category, 1, 40)
        && d.defaultLocation in ['pantry', 'cupboard', 'fridge', 'freezer']
        && d.allowedMeasures is list && d.allowedMeasures.size() >= 1
        && d.allowedMeasures.hasOnly(['weight', 'volume', 'count'])
        && d.canonicalUnit in ['g', 'count']
        && optNum(d, 'densityGPerMl') && optNum(d, 'unitWeightG') && optNum(d, 'proteinPer100g')
        && optNum(d, 'defaultPackAmount') && optNum(d, 'defaultCadenceDays')
        && (!('defaultPackMeasure' in d) || d.defaultPackMeasure in ['weight', 'volume', 'count'])
        && d.shelfLifeDays is map
        && d.freezable is bool && d.isStaple is bool && d.freeUse is bool && d.needsReview is bool
        && d.updatedBy == me() && d.updatedAt == request.time;
    }

    match /ingredients/{id} {
      allow get: if true;
      allow list: if allowed();
      allow create: if allowed() && validIngredient(request.resource.data)
        && request.resource.data.createdBy == me();
      allow update: if allowed() && validIngredient(request.resource.data)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
    }

    // ---------- recipes/{id} (§4.1, §4.4, §9): the global library

    function validRecipe(d) {
      return d.keys().hasOnly(['title', 'slug', 'servings', 'prepMin', 'cookMin', 'cuisine', 'mainProtein', 'tags',
                               'tools', 'ingredients', 'steps', 'prepTasks', 'defaultLeftoverPortions',
                               'leftoverMealType', 'proteinPerServingG', 'proteinApproximate', 'notes', 'sourceUrl',
                               'sourceUrlCanonical', 'fingerprint', 'ingredientIds', 'imagePaths', 'indexChunk',
                               'status', 'possibleDuplicateOf', 'trashedAt', 'trashedBy', 'createdBy', 'updatedBy',
                               'version', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'slug', 'servings', 'prepMin', 'cookMin', 'cuisine', 'mainProtein', 'tags',
                            'tools', 'ingredients', 'steps', 'prepTasks', 'defaultLeftoverPortions', 'fingerprint',
                            'ingredientIds', 'imagePaths', 'status', 'createdBy', 'updatedBy', 'version',
                            'createdAt', 'updatedAt'])
        && str(d.title, 1, 200) && str(d.slug, 1, 100)
        && d.servings is int && d.servings >= 1 && d.servings <= 100
        && d.prepMin is int && d.prepMin >= 0 && d.cookMin is int && d.cookMin >= 0
        && d.cuisine in ['american', 'british', 'canadian', 'caribbean', 'chinese', 'french', 'greek', 'indian',
                         'italian', 'japanese', 'korean', 'mediterranean', 'mexican', 'middle-eastern', 'nordic',
                         'spanish', 'thai', 'vietnamese', 'other']
        && d.mainProtein in ['beef', 'pork', 'chicken', 'turkey', 'lamb', 'fish', 'seafood', 'eggs', 'tofu',
                             'legumes', 'dairy', 'none']
        && d.tags is list && d.tags.size() <= 30
        && d.tools is list && d.tools.size() <= 30
        && d.ingredients is list && d.ingredients.size() <= 100
        && d.steps is list && d.steps.size() <= 100
        && d.prepTasks is list && d.prepTasks.size() <= 50
        && d.ingredientIds is list && d.ingredientIds.size() <= 100
        && d.imagePaths is list && d.imagePaths.size() <= 10
        && d.defaultLeftoverPortions is int && d.defaultLeftoverPortions >= 0
        && optStr(d, 'notes', 5000) && optStr(d, 'sourceUrl', 2000) && optStr(d, 'sourceUrlCanonical', 2000)
        && str(d.fingerprint, 1, 40)
        && d.status in ['active', 'pendingDuplicateReview', 'trashed']
        && d.version is int
        && d.updatedBy == me() && d.updatedAt == request.time;
    }
    // Trashing stamps who and when; any other status carries no trash fields (§4.4).
    function validTrashState(d, before) {
      return d.status == 'trashed'
        ? (before != null && before.status == 'trashed'
            ? d.trashedAt == before.trashedAt && d.trashedBy == before.trashedBy
            : d.trashedAt == request.time && d.trashedBy == me())
        : !('trashedAt' in d) && !('trashedBy' in d);
    }

    match /recipes/{id} {
      allow get: if true;                     // share links work without an account (R4.21)
      allow list: if allowed();
      // Version 1 with its snapshot in the same batch; the index function assigns indexChunk (§9).
      allow create: if allowed() && validRecipe(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.version == 1
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && !('indexChunk' in request.resource.data)
        && !('possibleDuplicateOf' in request.resource.data)
        && validTrashState(request.resource.data, null)
        && existsAfter(/databases/$(database)/documents/recipes/$(id)/versions/1);
      // Every save (edits, trash, restore, keep both) bumps the version by one and writes its snapshot (§9).
      allow update: if allowed() && validRecipe(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('indexChunk', null) == resource.data.get('indexChunk', null)
        && (request.resource.data.status != 'pendingDuplicateReview' || resource.data.status == 'pendingDuplicateReview')
        && validTrashState(request.resource.data, resource.data)
        && existsAfter(/databases/$(database)/documents/recipes/$(id)/versions/$(string(request.resource.data.version)));
      // Hard delete only for an import discarded in duplicate review (§9); the purge is a function.
      allow delete: if allowed() && resource.data.status == 'pendingDuplicateReview';

      match /versions/{v} {
        allow read: if allowed();
        allow create: if allowed()
          && v == string(getAfter(/databases/$(database)/documents/recipes/$(id)).data.version)
          && request.resource.data.editedBy == me()
          && request.resource.data.editedAt == request.time;
      }
    }

    // ---------- recipeIndex/{chunk} (§9): written by the index function only

    match /recipeIndex/{id} {
      allow read: if allowed();
    }

    // ---------- users/{uid}/notifications (§12, R12.1): created by functions; the owner reads and dismisses

    match /users/{uid}/notifications/{id} {
      allow read, delete: if uid == me() && allowed();
      allow update: if uid == me() && allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedAt'])
        && request.resource.data.dismissedAt == request.time;
    }

    // ---------- households/{hid}

    match /households/{hid} {
      allow read: if isMember(hid);
      allow update: if isMember(hid)
        && request.resource.data.createdBy == resource.data.createdBy
        && validHousehold(request.resource.data);
      // One batch: this doc, the creator's members/{uid}, and users/{uid}.householdsCreated + 1 (≤ 3) (R2.3).
      allow create: if allowed()
        && request.resource.data.createdBy == me()
        && validHousehold(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(me())).data.householdsCreated
             == get(/databases/$(database)/documents/users/$(me())).data.householdsCreated + 1
        && getAfter(/databases/$(database)/documents/users/$(me())).data.householdsCreated <= 3
        && existsAfter(/databases/$(database)/documents/households/$(hid)/members/$(me()));
      // No client deletes: a household goes away when its last member leaves (function, M4).

      match /members/{uid} {
        allow read: if isMember(hid);
        // Creator only, in the household's creation batch. Invites (M4) add the other two paths from §10.
        allow create: if uid == me() && allowed()
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'joinedAt'])
          && request.resource.data.uid == me()
          && validDisplayName(request.resource.data.displayName)
          && request.resource.data.joinedAt == request.time
          && !exists(/databases/$(database)/documents/households/$(hid))
          && getAfter(/databases/$(database)/documents/households/$(hid)).data.createdBy == me();
      }

      // Favourites (R4.6): one doc per target, keyed "<type>_<targetId>".
      match /favourites/{fid} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.keys().hasOnly(['type', 'targetId'])
          && request.resource.data.type in ['recipe', 'meal']
          && str(request.resource.data.targetId, 1, 200)
          && fid == request.resource.data.type + '_' + request.resource.data.targetId;
      }

      // The household's notes on a recipe (R4.8), keyed by recipe ID.
      match /notes/{recipeId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.keys().hasOnly(['text', 'updatedBy', 'updatedAt'])
          && str(request.resource.data.text, 0, 5000)
          && request.resource.data.updatedBy == me()
          && request.resource.data.updatedAt == request.time;
      }

      // Cook stats: function-maintained (M3); members read them for filters and cards.
      match /stats/{id} {
        allow read: if isMember(hid);
      }
    }

    // "My households": collection-group query on members where uid == me (§10). The rule reads the
    // duplicated uid field, which is what the query filters on, so Firestore can prove the query safe.
    match /{path=**}/members/{memberId} {
      allow read: if allowed() && resource.data.uid == me();
    }
  }
}
