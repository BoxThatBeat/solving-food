rules_version = '2';

// Solving Food security rules (TECHNICAL_SPECS §10).
// M0: allowlist, users, directory, households (+ members).
// M1: ingredients, recipes (+ versions), recipeIndex, households/*/favourites, notes, stats (read), and
//     users/*/notifications.
// M2: meals (saved meals, global), households/*/periods, planItems, stores, sourcingRules, brandMappings,
//     groceryLists.
// M3: households/*/commands (create), and member reads of the function-only supply (+ transactions), cookEvents,
//     ratings, stats, cadence; users/*/devices (web-push tokens) and users/*/timers (read). Everything else is
//     denied until the milestone that introduces it adds its rules.
// M4: households/*/invites (+ collection-group read of your own), member docs by accepting an invite, member deletes
//     (remove and leave). The household itself is deleted by the cleanup function when its last member leaves.
// M5: prices (read; written by functions), the snoozeCadence command, periods' dismissed expiry alerts
//     (`dismissedLots`), and the household's PC Express store name (`pcxStoreName`).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    // Firebase lower-cases emails already; lower() keeps the allowlist key canonical regardless.
    function email() {
      return request.auth.token.email.lower();
    }
    // Email-link sign-in always yields a verified address. Requiring it stops someone from using the
    // Email/Password provider to register an allowlisted address they don't own.
    function verified() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    // R2.12 / NFR4: every grant to a signed-in user requires an allowlist entry for their address.
    function allowed() {
      return verified() && exists(/databases/$(database)/documents/allowlist/$(email()));
    }
    function isMember(hid) {
      return allowed() && exists(/databases/$(database)/documents/households/$(hid)/members/$(me()));
    }
    // For writes: a member after this request. The creator's member doc is written in the household's creation
    // batch together with the first period and the default stores (and only the creator can write it), so the
    // creation batch passes and nothing else can use this to get in.
    function isMemberAfter(hid) {
      return allowed() && existsAfter(/databases/$(database)/documents/households/$(hid)/members/$(me()));
    }

    // ---------- validation helpers

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function validTheme(t) {
      return t is map
        && t.keys().hasOnly(['flavour', 'accent']) && t.keys().hasAll(['flavour', 'accent'])
        && t.flavour in ['latte', 'frappe', 'macchiato', 'mocha']
        && t.accent in ['green', 'teal', 'sapphire', 'blue', 'lavender', 'mauve', 'pink', 'flamingo',
                        'maroon', 'red', 'peach', 'yellow'];
    }
    function validDisplayName(n) {
      return str(n, 1, 40) && n.trim().size() > 0;
    }
    function optStr(d, k, max) {
      return !(k in d) || str(d[k], 0, max);
    }
    function optNum(d, k) {
      return !(k in d) || (d[k] is number && d[k] >= 0);
    }
    // An ingredient's side flag (R5.9): { portion } per person, canonical, positive.
    function validSidePortion(s) {
      return s is map && s.keys().hasOnly(['portion']) && s.portion is number && s.portion > 0;
    }
    function validHousehold(d) {
      return d.keys().hasOnly(['name', 'createdBy', 'periodDays', 'budgetCents', 'currency', 'timezone',
                               'defaultServings', 'plannedMealTypes', 'pcxStoreId', 'pcxStoreName', 'currentPeriodId',
                               'defaultStoreId', 'settings', 'createdAt'])
        && d.keys().hasAll(['name', 'createdBy', 'periodDays', 'budgetCents', 'currency', 'timezone',
                            'defaultServings', 'plannedMealTypes', 'pcxStoreId'])
        && str(d.name, 1, 60) && d.name.trim().size() > 0
        && d.periodDays is int && d.periodDays >= 1 && d.periodDays <= 28
        && d.budgetCents is int && d.budgetCents >= 0
        && d.currency == 'CAD'
        && str(d.timezone, 1, 64)
        && d.defaultServings is int && d.defaultServings >= 1 && d.defaultServings <= 20
        && d.plannedMealTypes is list && d.plannedMealTypes.size() >= 1
        && d.plannedMealTypes.hasOnly(['breakfast', 'lunch', 'dinner'])
        && str(d.pcxStoreId, 1, 100)
        && optStr(d, 'pcxStoreName', 120)
        && (!('settings' in d) || d.settings is map)
        && (!('currentPeriodId' in d) || d.currentPeriodId == null || str(d.currentPeriodId, 1, 200))
        && (!('defaultStoreId' in d) || str(d.defaultStoreId, 1, 200));
    }

    // ---------- allowlist/{emailLower}: sign-up allowlist (R2.12)

    match /allowlist/{emailLower} {
      // Only your own entry: the app checks it after sign-in. No listing.
      allow get: if verified() && emailLower == email();
      // Any allowlisted user can add an address (invite by email, R2.4).
      allow create: if allowed()
        && emailLower == emailLower.lower()
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt', 'inviteHouseholdId'])
        && request.resource.data.addedBy == me()
        && request.resource.data.addedAt == request.time
        && (!('inviteHouseholdId' in request.resource.data) || isMember(request.resource.data.inviteHouseholdId));
    }

    // ---------- users/{uid}: private to the user

    match /users/{uid} {
      allow read: if uid == me() && allowed();
      // First run (with directory/{uid}, same batch). The counter starts at 0.
      allow create: if uid == me() && allowed()
        && request.resource.data.keys().hasOnly(['email', 'activeHouseholdId', 'householdsCreated', 'theme', 'createdAt'])
        && request.resource.data.email == email()
        && request.resource.data.activeHouseholdId == null
        && request.resource.data.householdsCreated == 0
        && validTheme(request.resource.data.theme)
        && request.resource.data.createdAt == request.time;
      // Theme and active household are free to change. householdsCreated only ever goes up by one, to at
      // most 3, and only in the batch that creates a household (R2.3). Decrements are function-only (§10).
      allow update: if uid == me() && allowed()
        && changed().hasOnly(['activeHouseholdId', 'theme', 'householdsCreated'])
        && validTheme(request.resource.data.theme)
        && (request.resource.data.activeHouseholdId == null || str(request.resource.data.activeHouseholdId, 1, 200))
        && (!('householdsCreated' in changed()) || (
              request.resource.data.householdsCreated == resource.data.householdsCreated + 1
              && request.resource.data.householdsCreated <= 3
              && request.resource.data.activeHouseholdId is string
              && !exists(/databases/$(database)/documents/households/$(request.resource.data.activeHouseholdId))
              && existsAfter(/databases/$(database)/documents/households/$(request.resource.data.activeHouseholdId))));
    }

    // ---------- directory/{uid}: readable by every allowlisted user, for invites by name

    match /directory/{uid} {
      allow read: if allowed();
      allow create, update: if uid == me() && allowed()
        && request.resource.data.keys().hasOnly(['displayName', 'displayNameLower'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.displayNameLower == request.resource.data.displayName.lower();
    }


    // ---------- ingredients/{id} (§4.1, §5): public get for share-link pages; allowlisted users list and edit

    // M10 (R4.30): nutrition facts per 100 g (ingredients) or per serving (recipes); numbers ≥ 0, known keys only.
    function optNutrients(d) {
      return !('nutrients' in d) || validNutrients(d.nutrients);
    }
    function validNutrients(n) {
      return n is map && n.keys().hasOnly(['kcal', 'fatG', 'satFatG', 'transFatG', 'carbG', 'sugarsG', 'sodiumMg',
                                            'cholesterolMg', 'potassiumMg', 'calciumMg', 'ironMg'])
        && optNum(n, 'kcal') && optNum(n, 'fatG') && optNum(n, 'satFatG') && optNum(n, 'transFatG')
        && optNum(n, 'carbG') && optNum(n, 'sugarsG') && optNum(n, 'sodiumMg') && optNum(n, 'cholesterolMg')
        && optNum(n, 'potassiumMg') && optNum(n, 'calciumMg') && optNum(n, 'ironMg');
    }
    function validIngredient(d) {
      return d.keys().hasOnly(['name', 'aliases', 'category', 'defaultLocation', 'allowedMeasures', 'canonicalUnit',
                               'densityGPerMl', 'unitWeightG', 'proteinPer100g', 'fibrePer100g', 'nutrients', 'nutrientSource', 'shelfLifeDays', 'defaultPackAmount',
                               'defaultPackMeasure', 'defaultCadenceDays', 'freezable', 'isStaple', 'freeUse',
                               'needsReview', 'side', 'createdBy', 'updatedBy', 'updatedAt'])
        && d.keys().hasAll(['name', 'aliases', 'category', 'defaultLocation', 'allowedMeasures', 'canonicalUnit',
                            'shelfLifeDays', 'freezable', 'isStaple', 'freeUse', 'needsReview'])
        && str(d.name, 1, 80)
        && d.aliases is list && d.aliases.size() <= 40
        && str(d.category, 1, 40)
        && d.defaultLocation in ['pantry', 'cupboard', 'fridge', 'freezer']
        && d.allowedMeasures is list && d.allowedMeasures.size() >= 1
        && d.allowedMeasures.hasOnly(['weight', 'volume', 'count'])
        && d.canonicalUnit in ['g', 'count']
        && optNum(d, 'densityGPerMl') && optNum(d, 'unitWeightG') && optNum(d, 'proteinPer100g') && optNum(d, 'fibrePer100g')
        && optNutrients(d) && (!('nutrientSource' in d) || str(d.nutrientSource, 1, 160))
        && optNum(d, 'defaultPackAmount') && optNum(d, 'defaultCadenceDays')
        && (!('defaultPackMeasure' in d) || d.defaultPackMeasure in ['weight', 'volume', 'count'])
        && d.shelfLifeDays is map
        && d.freezable is bool && d.isStaple is bool && d.freeUse is bool && d.needsReview is bool
        && (!('side' in d) || validSidePortion(d.side))
        && d.updatedBy == me() && d.updatedAt == request.time;
    }

    match /ingredients/{id} {
      allow get: if true;
      allow list: if allowed();
      allow create: if allowed() && validIngredient(request.resource.data)
        && request.resource.data.createdBy == me();
      allow update: if allowed() && validIngredient(request.resource.data)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
    }

    // ---------- recipes/{id} (§4.1, §4.4, §9): the global library

    function validRecipe(d) {
      return d.keys().hasOnly(['title', 'slug', 'servings', 'prepMin', 'cookMin', 'cuisine', 'mainProtein', 'tags',
                               'tools', 'ingredients', 'steps', 'prepTasks', 'defaultLeftoverPortions',
                               'leftoverMealType', 'proteinPerServingG', 'proteinApproximate', 'fibrePerServingG', 'fibreApproximate',
                               'nutrition', 'nutritionApproximate', 'notes', 'sourceUrl',
                               'sourceUrlCanonical', 'fingerprint', 'ingredientIds', 'imagePaths', 'indexChunk',
                               'status', 'possibleDuplicateOf', 'trashedAt', 'trashedBy', 'createdBy', 'updatedBy',
                               'version', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'slug', 'servings', 'prepMin', 'cookMin', 'cuisine', 'mainProtein', 'tags',
                            'tools', 'ingredients', 'steps', 'prepTasks', 'defaultLeftoverPortions', 'fingerprint',
                            'ingredientIds', 'imagePaths', 'status', 'createdBy', 'updatedBy', 'version',
                            'createdAt', 'updatedAt'])
        && str(d.title, 1, 200) && str(d.slug, 1, 100)
        && d.servings is int && d.servings >= 1 && d.servings <= 100
        && d.prepMin is int && d.prepMin >= 0 && d.cookMin is int && d.cookMin >= 0
        && d.cuisine in ['american', 'british', 'canadian', 'caribbean', 'chinese', 'french', 'greek', 'indian',
                         'italian', 'japanese', 'korean', 'mediterranean', 'mexican', 'middle-eastern', 'nordic',
                         'spanish', 'thai', 'vietnamese', 'other']
        && d.mainProtein in ['beef', 'pork', 'chicken', 'turkey', 'lamb', 'fish', 'seafood', 'eggs', 'tofu',
                             'legumes', 'dairy', 'none']
        && d.tags is list && d.tags.size() <= 30
        && d.tools is list && d.tools.size() <= 30
        && d.ingredients is list && d.ingredients.size() <= 100
        && d.steps is list && d.steps.size() <= 100
        && d.prepTasks is list && d.prepTasks.size() <= 50
        && d.ingredientIds is list && d.ingredientIds.size() <= 100
        && d.imagePaths is list && d.imagePaths.size() <= 10
        && (!('nutrition' in d) || validNutrients(d.nutrition))
        && (!('nutritionApproximate' in d) || (d.nutritionApproximate is list && d.nutritionApproximate.size() <= 11))
        && d.defaultLeftoverPortions is int && d.defaultLeftoverPortions >= 0
        && optStr(d, 'notes', 5000) && optStr(d, 'sourceUrl', 2000) && optStr(d, 'sourceUrlCanonical', 2000)
        && str(d.fingerprint, 1, 40)
        && d.status in ['active', 'pendingDuplicateReview', 'trashed']
        && d.version is int
        && d.updatedBy == me() && d.updatedAt == request.time;
    }
    // Trashing stamps who and when; any other status carries no trash fields (§4.4).
    function validTrashState(d, before) {
      return d.status == 'trashed'
        ? (before != null && before.status == 'trashed'
            ? d.trashedAt == before.trashedAt && d.trashedBy == before.trashedBy
            : d.trashedAt == request.time && d.trashedBy == me())
        : !('trashedAt' in d) && !('trashedBy' in d);
    }

    match /recipes/{id} {
      allow get: if true;                     // share links work without an account (R4.21)
      allow list: if allowed();
      // Version 1 with its snapshot in the same batch; the index function assigns indexChunk (§9).
      allow create: if allowed() && validRecipe(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.version == 1
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && !('indexChunk' in request.resource.data)
        && !('possibleDuplicateOf' in request.resource.data)
        && validTrashState(request.resource.data, null)
        && existsAfter(/databases/$(database)/documents/recipes/$(id)/versions/1);
      // Every save (edits, trash, restore, keep both) bumps the version by one and writes its snapshot (§9).
      allow update: if allowed() && validRecipe(request.resource.data)
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('indexChunk', null) == resource.data.get('indexChunk', null)
        && (request.resource.data.status != 'pendingDuplicateReview' || resource.data.status == 'pendingDuplicateReview')
        && validTrashState(request.resource.data, resource.data)
        && existsAfter(/databases/$(database)/documents/recipes/$(id)/versions/$(string(request.resource.data.version)));
      // Hard delete only for an import discarded in duplicate review (§9); the purge is a function.
      allow delete: if allowed() && resource.data.status == 'pendingDuplicateReview';

      match /versions/{v} {
        allow read: if allowed();
        allow create: if allowed()
          && v == string(getAfter(/databases/$(database)/documents/recipes/$(id)).data.version)
          && request.resource.data.editedBy == me()
          && request.resource.data.editedAt == request.time;
      }
    }

    // ---------- meals/{id} (§4.1, R5.2): saved meals, global like recipes; public get for share links (R4.21)

    function validMealRecipes(l) {
      return l is list && l.size() >= 1 && l.size() <= 12;
    }
    // Sides (R5.9): ≤ 12 entries of { ingredientId, portion > 0 }; entries are checked by the client's zod schema.
    function validSides(d) {
      return !('sides' in d) || (d.sides is list && d.sides.size() <= 12);
    }
    function validMeal(d) {
      return d.keys().hasOnly(['name', 'recipes', 'sides', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'recipes', 'createdBy', 'updatedAt'])
        && str(d.name, 1, 80) && d.name.trim().size() > 0
        && validMealRecipes(d.recipes)
        && validSides(d)
        && d.updatedBy == me() && d.updatedAt == request.time;
    }

    match /meals/{id} {
      allow get: if true;
      allow list: if allowed();
      allow create: if allowed() && validMeal(request.resource.data)
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time;
      allow update: if allowed() && validMeal(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
      allow delete: if allowed();
    }

    // ---------- recipeIndex/{chunk} (§9): written by the index function only

    match /recipeIndex/{id} {
      allow read: if allowed();
    }

    // ---------- prices/{pcxStoreId}_{productCode} (§8, R6.21): PC Express prices, written by functions only

    match /prices/{id} {
      allow read: if allowed();
    }

    // ---------- users/{uid}/notifications (§12, R12.1): created by functions; the owner reads and dismisses

    match /users/{uid}/notifications/{id} {
      allow read, delete: if uid == me() && allowed();
      allow update: if uid == me() && allowed()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedAt'])
        && request.resource.data.dismissedAt == request.time;
    }

    // ---------- users/{uid}/devices (§11): web-push targets for timers; users/{uid}/timers: written by functions

    match /users/{uid}/devices/{token} {
      allow read, delete: if uid == me() && allowed();
      allow create, update: if uid == me() && allowed()
        && request.resource.data.keys().hasOnly(['platform', 'createdAt', 'lastSeenAt'])
        && str(request.resource.data.platform, 1, 40)
        && request.resource.data.lastSeenAt == request.time;
    }
    match /users/{uid}/timers/{timerId} {
      allow read: if uid == me() && allowed();
    }

    // ---------- commands (§6): the only way clients change supply, cook events, ratings, stats, and cadence.
    // The function validates the full payload with the shared zod schemas; rules check the envelope and the
    // payload's keys per type.
    function payloadKeys(t) {
      return t == 'addSupply' ? ['ingredientId', 'amount', 'location', 'entered']
        : t == 'receiveGroceries' ? ['listId', 'items']
        : t == 'finishCooking' ? ['cookEventId', 'planItemId', 'savedMealId', 'recipes', 'servings', 'mealType', 'title', 'sides']
        : t == 'submitReview' ? ['cookEventId', 'ratings', 'used', 'leftoverPortions', 'savedMealId', 'note']
        : t == 'correctSupply' ? ['supplyId', 'target', 'ingredientId', 'note']
        : t in ['discard', 'freeze', 'thaw'] ? ['supplyId', 'lotId', 'amount']
        : t == 'extendExpiry' ? ['supplyId', 'lotId', 'until']
        : t == 'markEaten' ? ['planItemId']
        : t == 'importHousehold' ? ['path']
        : t == 'snoozeCadence' ? ['ingredientId', 'until']
        : [];
    }
    function validCommand(d) {
      return d.keys().hasOnly(['type', 'payload', 'uid', 'createdAt', 'status'])
        && d.keys().hasAll(['type', 'payload', 'uid', 'createdAt', 'status'])
        && d.type in ['addSupply', 'receiveGroceries', 'finishCooking', 'submitReview', 'correctSupply', 'discard',
                      'extendExpiry', 'freeze', 'thaw', 'markEaten', 'importHousehold', 'snoozeCadence']
        && d.payload is map && d.payload.keys().hasOnly(payloadKeys(d.type))
        && d.status == 'pending'
        && d.createdAt == request.time;
    }

    function validPlanItem(d) {
      return d.keys().hasOnly(['periodId', 'kind', 'mealType', 'servings', 'recipes', 'sides', 'savedMealId', 'name',
                               'leftoverSupplyId', 'sourcePlanItemId', 'coverage', 'status', 'carriedFromId', 'addedBy',
                               'addedAt'])
        && d.keys().hasAll(['periodId', 'kind', 'mealType', 'servings', 'recipes', 'coverage', 'status', 'addedBy'])
        && str(d.periodId, 1, 200)
        && d.kind in ['meal', 'leftover', 'out']
        && d.mealType in ['breakfast', 'lunch', 'dinner', 'snack']
        && d.servings is number && d.servings > 0 && d.servings <= 100
        && d.recipes is list && d.recipes.size() <= 12 && (d.kind != 'meal' || d.recipes.size() >= 1)
        && (d.kind != 'out' || d.recipes.size() == 0)                 // eating out (M9): no recipes
        && validSides(d) && (d.kind == 'meal' || !('sides' in d))
        && d.coverage is map && d.coverage.keys().hasOnly(['breakfast', 'lunch', 'dinner'])
        && d.status in ['planned', 'cooked', 'skipped', 'eaten']
        && optStr(d, 'name', 80) && optStr(d, 'savedMealId', 200) && optStr(d, 'carriedFromId', 200)
        && str(d.addedBy, 1, 200);
    }

    // ---------- households/{hid}

    match /households/{hid} {
      allow read: if isMember(hid);
      allow update: if isMember(hid)
        && request.resource.data.createdBy == resource.data.createdBy
        && validHousehold(request.resource.data);
      // One batch: this doc, the creator's members/{uid}, and users/{uid}.householdsCreated + 1 (≤ 3) (R2.3).
      allow create: if allowed()
        && request.resource.data.createdBy == me()
        && validHousehold(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(me())).data.householdsCreated
             == get(/databases/$(database)/documents/users/$(me())).data.householdsCreated + 1
        && getAfter(/databases/$(database)/documents/users/$(me())).data.householdsCreated <= 3
        && existsAfter(/databases/$(database)/documents/households/$(hid)/members/$(me()));
      // No client deletes: a household goes away when its last member leaves (function, M4).

      match /members/{uid} {
        allow read: if isMember(hid);
        // Your own member doc, in one of three ways (§10): as the creator in the household's creation batch, or by
        // accepting an invite keyed by your uid (invite by name) or your address (invite by email, R2.4).
        allow create: if uid == me() && allowed()
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'joinedAt'])
          && request.resource.data.uid == me()
          && validDisplayName(request.resource.data.displayName)
          && request.resource.data.joinedAt == request.time
          && ((!exists(/databases/$(database)/documents/households/$(hid))
                && getAfter(/databases/$(database)/documents/households/$(hid)).data.createdBy == me())
              || exists(/databases/$(database)/documents/households/$(hid)/invites/$(me()))
              || exists(/databases/$(database)/documents/households/$(hid)/invites/$(email())));
        // No roles (R2.5): any member removes anyone, themselves included (leave, R2.13). The last member leaving
        // triggers the cleanup function that deletes the household.
        allow delete: if isMember(hid);
      }

      // Invites (§10, R2.4): keyed by the invitee's uid (by name) or lower-cased address (by email). Members create
      // and cancel them; the invitee reads and deletes (accept or decline) their own.
      match /invites/{key} {
        allow read: if isMember(hid) || (allowed() && (key == me() || key == email()));
        allow delete: if isMember(hid) || (allowed() && (key == me() || key == email()));
        allow create: if isMember(hid)
          && request.resource.data.keys().hasOnly(['inviteeUid', 'inviteeEmailLower', 'householdName', 'invitedBy',
                                                    'invitedByName', 'createdAt'])
          && request.resource.data.keys().hasAll(['householdName', 'invitedBy', 'invitedByName', 'createdAt'])
          && str(request.resource.data.householdName, 1, 60)
          && request.resource.data.householdName == get(/databases/$(database)/documents/households/$(hid)).data.name
          && request.resource.data.invitedBy == me()
          && validDisplayName(request.resource.data.invitedByName)
          && request.resource.data.createdAt == request.time
          && (('inviteeUid' in request.resource.data
                && !('inviteeEmailLower' in request.resource.data)
                && request.resource.data.inviteeUid == key
                && key != me()
                && !exists(/databases/$(database)/documents/households/$(hid)/members/$(key)))
              || ('inviteeEmailLower' in request.resource.data
                && !('inviteeUid' in request.resource.data)
                && request.resource.data.inviteeEmailLower == key
                && key == key.lower()
                && key.matches('^[^@/ ]+@[^@/ ]+[.][^@/ ]+$')));
      }

      // Favourites (R4.6): one doc per target, keyed "<type>_<targetId>".
      match /favourites/{fid} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.keys().hasOnly(['type', 'targetId'])
          && request.resource.data.type in ['recipe', 'meal']
          && str(request.resource.data.targetId, 1, 200)
          && fid == request.resource.data.type + '_' + request.resource.data.targetId;
      }

      // The household's notes on a recipe (R4.8), keyed by recipe ID.
      match /notes/{recipeId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.keys().hasOnly(['text', 'updatedBy', 'updatedAt'])
          && str(request.resource.data.text, 0, 5000)
          && request.resource.data.updatedBy == me()
          && request.resource.data.updatedAt == request.time;
      }

      // Function-only collections (§4.2, §10): members read, only the command function writes.
      match /stats/{id} {
        allow read: if isMember(hid);
      }
      match /supply/{doc=**} {
        allow read: if isMember(hid);
      }
      match /cookEvents/{id} {
        allow read: if isMember(hid);
      }
      match /ratings/{id} {
        allow read: if isMember(hid);
      }
      match /cadence/{id} {
        allow read: if isMember(hid);
      }

      // Commands (§6): a member writes their own, pending, with a valid envelope; nobody edits or deletes them.
      match /commands/{cid} {
        allow read: if isMember(hid);
        allow create: if isMember(hid) && request.resource.data.uid == me() && validCommand(request.resource.data);
      }

      // Periods (§7): ID = local start date; created at household creation and by the client's rollover
      // transaction. The budget snapshot follows a budget change in Settings.
      match /periods/{pid} {
        allow read: if isMember(hid);
        // `dismissedLots` (M5): supply lot IDs whose expiry alert a member dismissed for this period (R6.13).
        allow create, update: if isMemberAfter(hid)
          && request.resource.data.keys().hasOnly(['start', 'end', 'budgetCents', 'dismissedLots'])
          && request.resource.data.keys().hasAll(['start', 'end', 'budgetCents'])
          && request.resource.data.start is timestamp && request.resource.data.end is timestamp
          && request.resource.data.end > request.resource.data.start
          && request.resource.data.budgetCents is int && request.resource.data.budgetCents >= 0
          && (!('dismissedLots' in request.resource.data)
              || (request.resource.data.dismissedLots is list && request.resource.data.dismissedLots.size() <= 500));
      }

      // Plan items (§4.2, R5.1): meals of 1..n recipes; members add, edit, and remove them.
      match /planItems/{iid} {
        allow read, delete: if isMember(hid);
        // Cooking and eating change status through commands (M3); clients add planned items and edit them.
        allow create: if isMemberAfter(hid) && validPlanItem(request.resource.data)
          && request.resource.data.status == 'planned';
        allow update: if isMember(hid) && validPlanItem(request.resource.data)
          && request.resource.data.status == resource.data.status;
      }

      // Stores, sourcing rules, brand mappings (§4.2, §8, R7.3, R7.4).
      match /stores/{sid} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMemberAfter(hid)
          && request.resource.data.keys().hasOnly(['name', 'kind', 'bulk'])
          && request.resource.data.keys().hasAll(['name', 'kind', 'bulk'])
          && str(request.resource.data.name, 1, 80)
          && request.resource.data.kind in ['pcExpress', 'inStore']
          && request.resource.data.bulk is bool;
      }
      match /sourcingRules/{rid} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.keys().hasOnly(['match', 'storeId'])
          && request.resource.data.match is map
          && request.resource.data.match.size() == 1
          && (str(request.resource.data.match.get('category', ''), 1, 40)
              || str(request.resource.data.match.get('ingredientId', ''), 1, 200))
          && str(request.resource.data.storeId, 1, 200);
      }
      match /brandMappings/{ingredientId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.keys().hasOnly(['productName', 'productCode', 'packAmount', 'packMeasure', 'storeId',
                                                    'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasAll(['productName', 'packAmount', 'packMeasure', 'storeId'])
          && str(request.resource.data.productName, 1, 120)
          && optStr(request.resource.data, 'productCode', 100)
          && request.resource.data.packAmount is number && request.resource.data.packAmount > 0
          && request.resource.data.packMeasure in ['weight', 'volume', 'count']
          && str(request.resource.data.storeId, 1, 200);
      }

      // Grocery lists (§4.2, §8): the draft, and lists marked ordered by the Copy button (R7.5). Ticks are field
      // updates on the items map. "received" is set by the receiveGroceries command function (M3).
      match /groceryLists/{lid} {
        allow read: if isMember(hid);
        // A received list is history (its cost is the period's spend, R10.3): no edits or deletes.
        allow delete: if isMember(hid) && resource.data.status != 'received';
        allow create, update: if isMember(hid) && (resource == null || resource.data.status != 'received')
          && request.resource.data.keys().hasOnly(['periodId', 'status', 'createdAt', 'orderedAt', 'orderedBy', 'items', 'dismissedStaples'])
          && request.resource.data.keys().hasAll(['periodId', 'status', 'createdAt', 'items'])
          && request.resource.data.status in ['draft', 'ordered']
          && request.resource.data.items is map && request.resource.data.items.size() <= 400
          // M10 (R7.12): staples removed from the list, ingredient ID → until (ms).
          && (!('dismissedStaples' in request.resource.data) || (request.resource.data.dismissedStaples is map
              && request.resource.data.dismissedStaples.size() <= 300))
          && (request.resource.data.status == 'draft' || (request.resource.data.orderedAt is timestamp
              && request.resource.data.orderedBy is string));
      }
    }

    // "My households": collection-group query on members where uid == me (§10). The rule reads the
    // duplicated uid field, which is what the query filters on, so Firestore can prove the query safe.
    match /{path=**}/members/{memberId} {
      allow read: if allowed() && resource.data.uid == me();
    }

    // "My invites": two collection-group queries on invites (inviteeUid == me, inviteeEmailLower == my address).
    // Like members, the rule checks the fields the queries filter on.
    match /{path=**}/invites/{inviteKey} {
      allow read: if allowed()
        && (resource.data.get('inviteeUid', '') == me() || resource.data.get('inviteeEmailLower', '') == email());
    }
  }
}
